# Instellingen van SteynPT. Kopieer dit bestand naar .env en vul de waarden in (zie docs/live-zetten-vimexx-php.md).
# Zet .env nooit in git en deel het niet: er staan wachtwoorden en sleutels in.

APP_NAME=SteynPT
# production op de hosting; local op je eigen computer.
APP_ENV=production
# Wordt ingevuld met: php artisan key:generate
APP_KEY=
# Altijd false op de hosting (anders ziet een bezoeker bij een fout technische details).
APP_DEBUG=false
# Het adres van de site, zonder / aan het eind. Wordt gebruikt voor de uitnodigingslinks en de sitemap.
APP_URL=https://www.steynpt.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# MySQL-database uit DirectAdmin (MySQL-beheer). Bij Vimexx begint de naam met je gebruikersnaam.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies alleen via https (zet op false als je lokaal zonder https test).
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# Wachtrij voor de AI-concepten; wordt elke minuut verwerkt door de cronjob (php artisan schedule:run).
QUEUE_CONNECTION=database

# Er worden geen e-mails verstuurd; laat dit zo.
MAIL_MAILER=log

# E-mailadressen die automatisch beheerder worden (komma-gescheiden), bijvoorbeeld steyn@steynpt.nl.
ADMIN_EMAILS=

# AI-concepten voor trainings- en voedingsschema's (Claude van Anthropic). Maak een sleutel op platform.claude.com.
ANTHROPIC_API_KEY=
# Optioneel: een vast model. Leeg = automatisch het nieuwste Opus-model.
AI_MODEL=
# Alleen om te testen zonder API-sleutel: 1 = voorbeeldconcepten in plaats van de echte AI.
AI_MOCK=0

VITE_APP_NAME="${APP_NAME}"
