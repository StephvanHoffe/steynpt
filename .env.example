# Database: lokaal SQLite-bestand, of een Turso/libSQL URL in productie
DATABASE_URL=file:./data/steynpt.db
# Alleen nodig voor Turso (libsql://...)
DATABASE_AUTH_TOKEN=

# Publieke URL van de site (voor deel-links van het vriendenprogramma)
NEXT_PUBLIC_SITE_URL=https://www.steynpt.nl

# E-mailadressen die automatisch beheerder worden (komma-gescheiden)
ADMIN_EMAILS=

# AI-concepten voor trainings- en voedingsschema's (Claude van Anthropic).
# Zonder sleutel werkt alles, maar maakt Steyn schema's zelf.
ANTHROPIC_API_KEY=
# Testmodus: 1 = voorbeeldconcepten zonder API-sleutel (alleen voor lokaal testen!)
AI_MOCK=
